fn add(a: float, b: float) -> float {
    return a + b;
}

fn main() -> void {
    let x = 3.14;
    let y = 10.0;
    let z = 5;
    let a = 5 + 3.2;
    let b = (int)3.7;
    let c = (float)z;
    let d = 5 / 2;
    let e = 5 / 2.0;
    let f = 3 < 5.2;
    let g = 4.0 == 4;
    let h = add(5, 2.5);
    let x2: float = 5.0;
    let y2: int = (int)8.9;
    let z2: float = (float)y2;
    let x3 = 5.0 + 2;
    let y3 = 2 + 5.0;
    let x4: float = 5;
    let y4: int = (int)3.7;
    println!("x={} y={} z={} a={} b={} c={} d={} e={} f={} g={} h={} x2={} y2={} z2={} x3={} y3={} x4={} y4={}", x, y, z, a, b, c, d, e, f, g, h, x2, y2, z2, x3, y3, x4, y4);
}
