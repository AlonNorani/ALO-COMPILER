fn read_str(s: &string) -> void {
    println!("{}", s);
}

fn modify_arr(arr: &mut int[]) -> void {
    arr[0] = arr[0] + 1;
}

fn build_string() -> string {
    let s = "hello";
    return s;
}

fn main() -> void {
    let s1 = "hello";
    let s2 = s1;
    let s3 = copy(s2);
    println!("{} {}", s2, s3);

    let mut nums: int[] = [1, 2, 3];
    modify_arr(&mut nums);
    println!("{}", nums[0]);

    read_str(&s2);
    read_str(&s2);

    let s4 = build_string();
    println!("{}", s4);
}