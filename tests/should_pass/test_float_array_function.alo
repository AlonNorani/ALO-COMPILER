fn sum_array(arr: float[]) -> float {
    let mut i = 0;
    let mut sum = 0.0;
    while (i < 3) {
        sum = sum + arr[i];
        i = i + 1;
    }
    return sum;
}

fn main() -> void {
    let arr: float[3] = [1.5, 2.5, 3.5];
    let total = sum_array(arr);
    println!("total={}", total);
}
